local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

RunService.RenderStepped:Connect(function()
    local closestPlayer = nil
    local closestDistance = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local distance = (player.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if distance < closestDistance then
                closestDistance = distance
                closestPlayer = player
            end
        end
    end
    
    if closestPlayer and closestPlayer.Character then
        workspace.CurrentCamera.CFrame = CFrame.new(
            workspace.CurrentCamera.CFrame.Position,
            closestPlayer.Character.HumanoidRootPart.Position
        )
    end
end)]]
        end
    end
    
    -- Remote exploitation
    if input:find("remote") then
        return "I've detected " .. remoteCount .. " remotes. To exploit them, use the Remote Spy tab to identify the target, then use :FireServer() or :InvokeServer() with appropriate arguments."
    end
    
    -- Game information
    if input:find("game") or input:find("what") and input:find("playing") then
        return "You are playing: " .. gameName .. "\n\nDescription: " .. gameDesc
    end
    
    -- Conversation
    if input:find("hello") or input:find("hi") then
        return "Hello! I'm ChromeIntelligence. I can help you with scripts, exploits, game info, and more. What do you need?"
    elseif input:find("help") then
        return "I can help with:\n- Script generation (lag, ESP, speed, fly, aimbot)\n- Remote exploitation\n- Game information\n- Lua scripting\n- Debugging\n\nWhat would you like?"
    elseif input:find("save") then
        -- Save conversation
        local saveData = HttpService:JSONEncode(conversationHistory)
        writefile("ChromeIntelligence_Conversation.json", saveData)
        return "Conversation saved to ChromeIntelligence_Conversation.json"
    elseif input:find("load") then
        -- Load conversation
        if isfile("ChromeIntelligence_Conversation.json") then
            local loadData = HttpService:JSONDecode(readfile("ChromeIntelligence_Conversation.json"))
            for _, msg in ipairs(loadData) do
                addChatMessage(msg.sender, msg.message, msg.isAI)
            end
            return "Conversation loaded successfully!"
        end
        return "No saved conversation found."
    else
        return "I understand you're asking about: '" .. input .. "'. I can help with scripts, exploits, game info, and more. Try asking about specific features."
    end
end

-- Apply Era Function
function applyEra(eraName)
    local era = Eras[eraName]
    
    -- Apply to all elements
    BrowserFrame.BackgroundColor3 = era.Background
    BrowserTopBar.BackgroundColor3 = era.Secondary
    TabBar.BackgroundColor3 = era.Secondary
    ContentArea.BackgroundColor3 = era.Background
    
    -- Update all text colors and fonts
    for _, tabBtn in ipairs(TabButtons) do
        tabBtn.BackgroundColor3 = era.Background
        tabBtn.TextColor3 = era.Text
        tabBtn.Font = era.Font
    end
    
    -- Update all labels
    for _, child in ipairs(ContentArea:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
            child.Font = era.Font
            if not child:IsA("TextButton") then
                child.TextColor3 = era.Text
            end
        end
        if child:IsA("Frame") then
            child.BackgroundColor3 = era.Secondary
        end
    end
    
    -- Update corners
    for _, corner in ipairs(BrowserFrame:GetDescendants()) do
        if corner:IsA("UICorner") then
            corner.CornerRadius = UDim.new(0, era.CornerStyle)
        end
    end
    
    logToConsole("UI Era changed to: " .. eraName, "success")
end

-- Tab Switching
local function switchTab(index)
    for i, tabBtn in ipairs(TabButtons) do
        if i == index then
            tabBtn.BackgroundColor3 = Eras[CurrentEra].Accent
            tabBtn.TextColor3 = Eras[CurrentEra].Background
        else
            tabBtn.BackgroundColor3 = Eras[CurrentEra].Background
            tabBtn.TextColor3 = Eras[CurrentEra].Text
        end
    end
    
    AIChatTab.Visible = (index == 1)
    ScriptGenTab.Visible = (index == 2)
    RemoteSpyTab.Visible = (index == 3)
    EraSettingsTab.Visible = (index == 4)
    ConsoleTab.Visible = (index == 5)
end

for i, tabBtn in ipairs(TabButtons) do
    tabBtn.MouseButton1Click:Connect(function()
        switchTab(i)
    end)
end

-- Send Message
SendBtn.MouseButton1Click:Connect(function()
    local message = ChatInputBox.Text
    if message ~= "" then
        addChatMessage("You", message, false)
        ChatInputBox.Text = ""
        
        task.delay(0.5, function()
            local response = getAIResponse(message)
            addChatMessage("ChromeIntelligence", response, true)
        end)
    end
end)

ChatInputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SendBtn.MouseButton1Click:Fire()
    end
end)

-- Script Generator
GenerateBtn.MouseButton1Click:Connect(function()
    local description = ScriptInput.Text
    if description ~= "" then
        local response = getAIResponse(description)
        ScriptOutput.Text = response
        logToConsole("Script generated for: " .. description, "success")
    end
end)

-- Close Button
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Minimize Button
local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        BrowserFrame.Size = UDim2.new(0, 300, 0, 40)
        BrowserFrame.Position = UDim2.new(0, 10, 1, -50)
