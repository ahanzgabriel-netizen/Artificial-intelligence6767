local consoleCount = 0
function logToConsole(message, type)
    consoleCount = consoleCount + 1
    
    local logItem = Instance.new("Frame")
    logItem.Size = UDim2.new(1, -10, 0, 25)
    logItem.Position = UDim2.new(0, 5, 0, (consoleCount - 1) * 30)
    logItem.BackgroundColor3 = Eras[CurrentEra].Background
    logItem.BorderSizePixel = 0
    logItem.Parent = ConsoleBox
    
    local logColor = Eras[CurrentEra].Text
    if type == "error" then
        logColor = Color3.fromRGB(255, 100, 100)
    elseif type == "success" then
        logColor = Color3.fromRGB(0, 255, 100)
    elseif type == "info" then
        logColor = Color3.fromRGB(100, 150, 255)
    end
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -10, 1, 0)
    msgLabel.Position = UDim2.new(0, 10, 0, 0)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = "[" .. os.clock() .. "] " .. message
    msgLabel.TextColor3 = logColor
    msgLabel.TextSize = 10
    msgLabel.Font = Enum.Font.Code
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.Parent = logItem
end

