-- Scan Remotes
local remoteCount = 0
local function scanRemotes()
    local containers = {
        ReplicatedStorage,
        ServerStorage,
        Workspace
    }
    
    local function scanInstance(instance)
        for _, child in ipairs(instance:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("BindableEvent") or child:IsA("BindableFunction") then
                remoteCount = remoteCount + 1
                
                local remoteItem = Instance.new("Frame")
                remoteItem.Size = UDim2.new(1, -10, 0, 30)
                remoteItem.Position = UDim2.new(0, 5, 0, (remoteCount - 1) * 35)
                remoteItem.BackgroundColor3 = Eras[CurrentEra].Background
                remoteItem.BorderSizePixel = 0
                remoteItem.Parent = SpyList
                
                local typeLabel = Instance.new("TextLabel")
                typeLabel.Size = UDim2.new(0, 100, 1, 0)
                typeLabel.BackgroundColor3 = Eras[CurrentEra].Accent
                typeLabel.Text = child.ClassName
                typeLabel.TextColor3 = Eras[CurrentEra].Background
                typeLabel.TextSize = 9
                typeLabel.Font = Eras[CurrentEra].Font
                typeLabel.Parent = remoteItem
                
                local nameLabel = Instance.new("TextLabel")
                nameLabel.Size = UDim2.new(1, -110, 1, 0)
                nameLabel.Position = UDim2.new(0, 105, 0, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = child.Name
                nameLabel.TextColor3 = Eras[CurrentEra].Text
                nameLabel.TextSize = 10
                nameLabel.Font = Eras[CurrentEra].Font
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = remoteItem
            end
            
            if #child:GetChildren() > 0 then
                scanInstance(child)
            end
        end
    end
    
    for _, container in ipairs(containers) do
        scanInstance(container)
    end
end

scanRemotes()

