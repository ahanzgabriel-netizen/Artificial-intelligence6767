    maximized = not maximized
    if maximized then
        BrowserFrame.Size = UDim2.new(1, 0, 1, 0)
        BrowserFrame.Position = UDim2.new(0, 0, 0, 0)
    else
        BrowserFrame.Size = UDim2.new(0, 900, 0, 600)
        BrowserFrame.Position = UDim2.new(0.5, -450, 0.5, -300)
    end
end)

